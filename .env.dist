# Copy this file to .env and adjust to your needs.
# .env is gitignored and never committed.

# Your host user/group IDs. Auto-detected by the Makefile if not set.
# Override here only if the auto-detected values are wrong.
#USER_UID=1000
#USER_GID=1000

# Required. Password for the web UI and server API (HTTP Basic Auth, username "opencode").
OPENCODE_SERVER_PASSWORD=

# Pin a specific OpenCode version (e.g. 1.18.35) for reproducible builds.
# Recommended. Leave empty to install the latest release at build time.
#OPENCODE_VERSION=
#OH_MY_OPENCODE_SLIM_VERSION=

# Comma-separated list of plugins to include in the image.
# Available plugins: midi, excel, browser, image, github, linear
# Example: PLUGINS=midi,excel
#PLUGINS=

# GitHub plugin (PLUGINS=...,github): authenticate gh and git as a GitHub
# App. Required when the github plugin is enabled — see README "GitHub
# plugin" for how to create and install the App.
#GH_APP_ID=
# Host path to the App's private key (e.g.
# ~/.config/opencode-secrets/github-app.pem) — mounted read-only and never
# committed.
#GH_APP_PRIVATE_KEY_PATH=
# Optional. Only needed if the App is installed on more than one account.
#GH_APP_INSTALLATION_ID=
# Optional. Numeric user id of the App's bot account (<slug>[bot]) — NOT the
# App ID or Client ID. Only needed when the bot account can't be looked up,
# e.g. in enterprise orgs. See README "GitHub plugin".
#GH_APP_BOT_USER_ID=

# Linear plugin (PLUGINS=...,linear): personal API key for the Linear MCP.
# Required when the linear plugin is enabled — see README "Linear plugin".
# Use a dedicated or Read-only key; it is visible to agents with bash access.
#LINEAR_API_KEY=

# Kanban plugin (PLUGINS=...,kanban): GitHub App the kanban poller uses to
# read PRs, CI checks and run logs, clone missing checkouts, and push the
# clean base merge on conflicting PRs. Required when the kanban plugin is
# enabled. Permissions: Pull requests, Checks, Commit statuses, Actions and
# Metadata read-only, Contents read and write. To reuse the github plugin's
# App, repeat the GH_APP_* values above; it then needs Contents: write too.
# See README "Kanban plugin".
#KANBAN_GH_APP_ID=
#KANBAN_GH_APP_PRIVATE_KEY_PATH=
# Optional. Only needed if the App is installed on more than one account.
#KANBAN_GH_APP_INSTALLATION_ID=
# Directory that holds your checkouts. A Linear project without a `path:` line
# uses <root>/<repo name>, cloned there if missing. Use the same path as the
# projects mount in compose.override.yml. Other KANBAN_* settings: see the
# README env table.
#KANBAN_PROJECTS_ROOT=/full/path/to/my/projects
