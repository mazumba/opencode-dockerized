# Copy this file to .env and adjust to your needs.
# .env is gitignored and never committed.

# Your host user/group IDs. Auto-detected by the Makefile if not set.
# Override here only if the auto-detected values are wrong.
#USER_UID=1000
#USER_GID=1000

# Required. Password for the web UI and server API (HTTP Basic Auth, username "opencode").
OPENCODE_SERVER_PASSWORD=

# Pin a specific OpenCode version. Leave empty to use the latest.
#OPENCODE_VERSION=
#OH_MY_OPENCODE_SLIM_VERSION=

# Comma-separated list of plugins to include in the image.
# Available plugins: midi, excel, browser, image, github
# Example: PLUGINS=midi,excel
#PLUGINS=

# GitHub plugin (PLUGINS=...,github): authenticate gh and git as a GitHub
# App. Required when the github plugin is enabled — see README "GitHub
# plugin" for how to create and install the App.
#GH_APP_ID=
# Host path to the App's private key (e.g.
# ~/.config/opencode-secrets/github-app.pem) — mounted read-only and never
# committed.
#GH_APP_PRIVATE_KEY_PATH=
# Optional. Only needed if the App is installed on more than one account.
#GH_APP_INSTALLATION_ID=
# Optional. Numeric user id of the App's bot account (<slug>[bot]) — NOT the
# App ID or Client ID. Only needed when the bot account can't be looked up,
# e.g. in enterprise orgs. See README "GitHub plugin".
#GH_APP_BOT_USER_ID=
