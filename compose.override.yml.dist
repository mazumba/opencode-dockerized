services:
  opencode:
    volumes:
#     IMPORTANT: Use the full path to your projects directory to avoid dind volume mounting issues.
#     With the mention plugin this must also be MENTION_PROJECTS_ROOT (the
#     mention-poller service mounts that path itself):
      - /full/path/to/my/projects:/full/path/to/my/projects
#     OpenCode 1 credentials: imported once, on the first start of a new or V1
#     volume. Remove the line afterwards (see README "Importing an OpenCode 1 auth.json").
#     - ./.opencode/share/auth.json:/home/opencode/.local/share/opencode/auth.json
#   Token for a custom OpenAI-compatible provider, if you set OPEN_AI_TOKEN in .env:
#   environment:
#     OPEN_AI_TOKEN: ${OPEN_AI_TOKEN:?OPEN_AI_TOKEN is not set. Set it in .env}

  # Only with the kanban plugin. Same real host path as opencode, mounted at the
  # same path: KANBAN_PROJECTS_ROOT points here, and lane stacks bind-mount from it.
  # Keep the profile: without the kanban plugin this stanza has no image, and an
  # unprofiled service without an image makes every compose command fail.
  kanban-poller:
    profiles: ["kanban-poller"]
    volumes:
      - /full/path/to/my/projects:/full/path/to/my/projects
