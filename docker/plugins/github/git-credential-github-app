#!/bin/sh
# git-credential-github-app — git credential helper backing onto gh-app-token.
#
# Installed via `git config --global credential."https://github.com".helper
# <absolute path to this file>` by github.entrypoint.sh. git invokes it with
# one of "get", "store", "erase" as $1. Only "get" does anything: "store"
# and "erase" are no-ops because the token is always minted fresh (or read
# from gh-app-token's own cache) and must never be persisted by git itself.
set -eu

case "${1:-}" in
    get)
        token=$(/usr/local/lib/opencode/github/gh-app-token)
        printf 'username=x-access-token\n'
        printf 'password=%s\n' "$token"
        ;;
    store | erase)
        exit 0
        ;;
    *)
        echo "git-credential-github-app: unknown operation '${1:-}'" >&2
        exit 1
        ;;
esac
