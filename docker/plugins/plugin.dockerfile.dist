# Plugin: <name>
# <Short description of what this plugin adds>
#
# Plugin convention: each plugin lives in docker/plugins/<name>/ and may carry up to six files:
#
#   <name>.dockerfile        — system/apt dependencies (required)
#                              Injected into Dockerfile.generated at the "# {{plugins}}" marker.
#
#   <name>.package.json      — npm dependencies to merge (optional)
#                              Merged into .opencode/config/package.json by build-plugins.sh.
#                              OpenCode runs `bun install` automatically at startup.
#
#   <name>.opencode.jsonc    — MCP config fragment (optional)
#                              Injected into .opencode/config/opencode.jsonc at the
#                              "// {{mcp-plugins}}" marker inside the "mcp" block.
#
#   <name>.agent.jsonc       — opencode agent fragment (optional)
#                              Defines an agent that exclusively owns this plugin's MCP
#                              tools. Injected into .opencode/config/opencode.jsonc at the
#                              "// {{agent-plugins}}" marker inside the "agent" block. If
#                              the plugin also ships an MCP fragment (<name>.opencode.jsonc),
#                              that server's "<server>_*" tools are denied for all agents at
#                              the "// {{permission-plugins}}" marker, so only this agent —
#                              via its own "permission" block — can use them.
#
#   <name>.entrypoint.sh     — startup hook (optional)
#                              A POSIX `sh` script. build-plugins.sh validates it with
#                              `sh -n` and injects a `COPY --chmod=0755` instruction at the
#                              "# {{plugin-hooks}}" marker in Dockerfile, installing it as
#                              /usr/local/lib/opencode/entrypoint.d/NNN-<name>.sh — the
#                              zero-padded ordinal reflects its position among enabled
#                              plugin hooks, preserving their order in PLUGINS.
#                              docker/entrypoint.sh runs every hook, in lexical (i.e. NNN)
#                              order, as a separate `sh` process, as root, after Docker
#                              socket setup and before the gosu privilege drop. Because
#                              entrypoint.sh runs under `set -e`, a hook that exits
#                              non-zero aborts container startup (fail-closed) — hooks
#                              that perform security-relevant setup (e.g. updating a
#                              signature database) should fail loudly rather than warn
#                              and continue.
#
#   <name>.compose.yml       — Compose fragment (optional)
#                              Layered on top of the repo's compose.yml by
#                              docker/compose-with-plugins.sh via a repeated `-f` flag, in
#                              PLUGINS order, whenever this plugin is enabled. Use it for
#                              plugin-specific volumes, environment, ports, etc. Compose
#                              performs the merge and validation itself (`docker compose
#                              config`); no merged file is generated or committed.
#
# Only <name>.dockerfile is required; the other five are optional.
#
# To activate: set PLUGINS=<name> in .env and run `make opencode-build-plugins`.
#
# Available package managers:
#
#   apt-get  — system/native packages (Debian bookworm)
#              Use --no-install-recommends to keep the layer lean.
#
#   pip      — Python packages, for when no apt package exists
#              Install python3-pip via apt first.
#              Always pass --break-system-packages (required on Debian bookworm).
#              Upgrade pip/setuptools/wheel first if packages require a build step.
#
# ─── System packages ───────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
    <package>

# ─── Python packages via pip ───────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    && python3 -m pip install --break-system-packages \
      <package>
