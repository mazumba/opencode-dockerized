{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "bash": "ask"
    // Plugin-owned MCP tools are denied for all agents here except the
    // plugin's own agent; keep this last — permission rules are last-match-wins.
    // {{permission-plugins}}
  },
  "agent": {
    "plan": {
      "model": "github-copilot/claude-opus-5.5",
      "variant": "medium"
    },
    "build": {
      "model": "github-copilot/gpt-6.1-sol",
      "variant": "high"
    },
    "general": {
      "model": "github-copilot/gpt-6.1-sol",
      "variant": "high"
    },
    "explore": {
      "model": "github-copilot/gpt-6-luna",
      "variant": "medium"
    },
    "quota": {
      "model": "github-copilot/gpt-6-luna",
      "variant": "low"
    },
    // injection marker for plugin agent fragments; see docker/plugins/plugin.dockerfile.dist for details
    // {{agent-plugins}}
  },
  "mcp": {
    // injection marker for MCP plugin configuration fragments; see docker/plugins/plugin.dockerfile.dist for details
    // {{mcp-plugins}}
  },
  "plugin": [
    "oh-my-opencode-slim"
  ],
  "lsp": true
}
